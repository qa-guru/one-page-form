{
  "name": "UI Tests",
  "historyPath": "./history.jsonl",
  "appendHistory": true,
  "historyLimit": 20,
  "plugins": {
    "awesome": {
      "options": {
        "reportLanguage": "ru"
      }
    },
    "dashboard": {
      "options": {
        "reportName": "UI Tests Dashboard",
        "reportLanguage": "ru",
        "layout": [
          {
            "type": "statusDynamics",
            "title": "Динамика статусов",
            "limit": 20
          },
          {
            "type": "durationDynamics",
            "title": "Динамика длительности",
            "limit": 20
          },
          {
            "type": "currentStatus",
            "title": "Текущий статус"
          },
          {
            "type": "statusTransitions",
            "title": "Переходы статусов",
            "limit": 20
          }
        ]
      }
    }
  }
}
